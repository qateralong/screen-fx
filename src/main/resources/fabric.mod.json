{
  "schemaVersion": 1,
  "id": "screenfx",
  "version": "${version}",
  "name": "ScreenFX",
  "description": "Server-triggered screen effects: overlays, eyelids, frost, color filters, distortions, camera motion, resource-pack shaders and images, server presets.",
  "authors": [
    "qateralong"
  ],
  "license": "All Rights Reserved",
  "icon": "assets/screenfx/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.qateralong.screenfx.ScreenFx"
    ],
    "client": [
      "com.qateralong.screenfx.client.ScreenFxClient"
    ]
  },
  "mixins": [
    "screenfx.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}